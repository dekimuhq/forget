{
  "name": "@dekimuhq/forget-roster",
  "version": "0.2.0",
  "description": "Interval-leaf range-Merkle roster of active subjects with signed roots and non-inclusion (proof-of-absence) proofs.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@dekimuhq/crypto": "^1.4.0",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.6.1"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dekimuhq/forget.git",
    "directory": "packages/forget-roster"
  },
  "homepage": "https://github.com/dekimuhq/forget/tree/main/packages/forget-roster#readme",
  "bugs": {
    "url": "https://github.com/dekimuhq/forget/issues"
  }
}

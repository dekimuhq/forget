{
  "name": "forget-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Development workspace for the Proof of Forgetting reference implementation. The workspace root is not published; each package under packages/ is published to npm separately.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dekimuhq/forget.git"
  },
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@types/node": "22.20.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@changesets/parse": {
      "js-yaml": "^4.3.0"
    },
    "read-yaml-file": {
      "js-yaml": "^3.15.0"
    },
    "postcss": "^8.5.18",
    "esbuild": "^0.28.1"
  }
}
